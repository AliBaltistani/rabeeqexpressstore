APP_NAME="Rabeq Express Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── Frontend (for CORS) ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ──────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eseven_store
DB_USERNAME=root
DB_PASSWORD=

# ─── Session / Cache / Queue ───────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── Mail ──────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@rabeqstore.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Twilio (SMS OTP & Notifications) ─────────────────────────────────────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ─── Social Login (Laravel Socialite) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/auth/social/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/api/v1/auth/social/facebook/callback

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=${APP_URL}/api/v1/auth/social/apple/callback
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ─── Stripe Payments ──────────────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ─── SMSA Shipping ─────────────────────────────────────────────────────────
SMSA_PASS_KEY=
SMSA_WSDL_URL=https://track.smsaexpress.com/SELOAPI/ServiceSELO.svc?wsdl

# ─── Vite ──────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=${APP_URL}
